[bigdata-bigtop]
name=Bigdata Bigtop Repository
baseurl=http://${REPO_HOST}/bigdata/bigtop/${OS_TARGET}/$basearch
enabled=1
gpgcheck=1
gpgkey=http://${REPO_HOST}/bigdata/bigtop/RPM-GPG-KEY-bigdata
priority=1

[bigdata-bigtop-noarch]
name=Bigdata Bigtop Noarch Repository
baseurl=http://${REPO_HOST}/bigdata/bigtop/${OS_TARGET}/noarch
enabled=1
gpgcheck=1
gpgkey=http://${REPO_HOST}/bigdata/bigtop/RPM-GPG-KEY-bigdata
priority=1
