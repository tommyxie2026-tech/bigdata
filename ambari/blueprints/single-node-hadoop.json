{
  "Blueprints": {
    "blueprint_name": "single-node-hadoop",
    "stack_name": "BIGDATA",
    "stack_version": "1.0"
  },
  "host_groups": [
    {
      "name": "master",
      "cardinality": "1",
      "components": [
        { "name": "NAMENODE" },
        { "name": "DATANODE" },
        { "name": "HDFS_CLIENT" },
        { "name": "RESOURCEMANAGER" },
        { "name": "NODEMANAGER" },
        { "name": "YARN_CLIENT" },
        { "name": "HIVE_SERVER" },
        { "name": "HIVE_METASTORE" },
        { "name": "HIVE_CLIENT" },
        { "name": "SPARK_HISTORYSERVER" },
        { "name": "SPARK_CLIENT" }
      ]
    }
  ],
  "configurations": [
    {
      "core-site": {
        "properties": {
          "fs.defaultFS": "hdfs://%HOSTGROUP::master%:8020"
        }
      }
    },
    {
      "hdfs-site": {
        "properties": {
          "dfs.replication": "1",
          "dfs.namenode.name.dir": "/hadoop/hdfs/namenode",
          "dfs.datanode.data.dir": "/hadoop/hdfs/data"
        }
      }
    },
    {
      "yarn-site": {
        "properties": {
          "yarn.resourcemanager.hostname": "%HOSTGROUP::master%",
          "yarn.nodemanager.resource.memory-mb": "4096",
          "yarn.scheduler.minimum-allocation-mb": "512"
        }
      }
    }
  ]
}
